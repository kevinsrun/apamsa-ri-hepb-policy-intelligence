                            <div class="typography">
                  <h1>Student Groups</h1>
                                        <p class="page_intro">Medical student groups at Brown provide endless opportunities to learn, serve, network, lead, create, and relax.</p>
                                    </div>
            </div>
                      
          
          
          
                    
