      <div class="view-header qh__prose--headings-only">
      <h2>Resources</h2>

<script>

window.addEventListener('DOMContentLoaded',function () {

var testContainer = document.querySelector('.view-topics-resources');
    var viewContent = testContainer.querySelector('.view-content'); 
   

function sortDivsByH3() {
  const container = viewContent; // Replace with your container ID
  const divs = Array.from(container.children);

  divs.sort((a, b) => {
    const h3A = a.querySelector('h3').textContent;
    const h3B = b.querySelector('h3').textContent;
    return h3A.localeCompare(h3B); // Case-insensitive sorting
  });

  divs.forEach(div => container.appendChild(div));
}

sortDivsByH3(); 


// Get all the list items
const listItems = testContainer.querySelectorAll('li');
// Create a Set to store unique values
const uniqueValues = new Set();
// Iterate through the list items
listItems.forEach(item => {
  const textContent = item.textContent.trim();
  // If the text content is not already in the Set, add it
  if (!uniqueValues.has(textContent)) {
    uniqueValues.add(textContent);
  } else {
    // If it's a duplicate, remove the list item
    item.remove();
  }
});


});   

</script>
